@page
@model Libreria.Pages.Libros.EditModel
@{
    ViewData["Title"] = "Editar Libro";
}

<h1>Editar Libro</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Libro.Id" />

            <div class="mb-3">
                <label asp-for="Libro.Titulo" class="form-label"></label>
                <input asp-for="Libro.Titulo" class="form-control" />
                <span asp-validation-for="Libro.Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Libro.Autor" class="form-label"></label>
                <input asp-for="Libro.Autor" class="form-control" />
                <span asp-validation-for="Libro.Autor" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Libro.ISBN" class="form-label"></label>
                <input asp-for="Libro.ISBN" class="form-control" />
                <span asp-validation-for="Libro.ISBN" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Libro.AnioPublicacion" class="form-label"></label>
                <input asp-for="Libro.AnioPublicacion" class="form-control" />
                <span asp-validation-for="Libro.AnioPublicacion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Libro.PrecioAlquiler" class="form-label"></label>
                <input asp-for="Libro.PrecioAlquiler" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Libro.PrecioAlquiler" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Volver al Listado</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}