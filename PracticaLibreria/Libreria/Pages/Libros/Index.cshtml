@page
@model Libreria.Pages.Libros.IndexModel
@{
    ViewData["Title"] = "Listado de Libros";
}

<h1 class="mb-3">Listado de Libros</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Crear Nuevo Libro</a>
</p>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Libro[0].Titulo)</th>
            <th>@Html.DisplayNameFor(model => model.Libro[0].Autor)</th>
            <th>@Html.DisplayNameFor(model => model.Libro[0].ISBN)</th>
            <th>@Html.DisplayNameFor(model => model.Libro[0].AnioPublicacion)</th>
            <th>@Html.DisplayNameFor(model => model.Libro[0].PrecioAlquiler)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Libro)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                <td>@Html.DisplayFor(modelItem => item.Autor)</td>
                <td>@Html.DisplayFor(modelItem => item.ISBN)</td>
                <td>@Html.DisplayFor(modelItem => item.AnioPublicacion)</td>
                <td>@Html.DisplayFor(modelItem => item.PrecioAlquiler)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>