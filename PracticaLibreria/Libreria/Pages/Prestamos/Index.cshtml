@page
@model Libreria.Pages.Prestamos.IndexModel
@{
    ViewData["Title"] = "Listado de Préstamos";
}

<h1 class="mb-3">Listado de Préstamos</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Registrar Nuevo Préstamo</a>
</p>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Prestamo[0].CodigoPrestamo)</th>
            <th>@Html.DisplayNameFor(model => model.Prestamo[0].FechaPrestamo)</th>
            <th>@Html.DisplayNameFor(model => model.Prestamo[0].FechaDevolucion)</th>
            <th>@Html.DisplayNameFor(model => model.Prestamo[0].Estado)</th>
            <th>@Html.DisplayNameFor(model => model.Prestamo[0].Observaciones)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Prestamo)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.CodigoPrestamo)</td>
                <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                <td>@item.FechaDevolucion.ToString("dd/MM/yyyy")</td>
                <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                <td>@Html.DisplayFor(modelItem => item.Observaciones)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>