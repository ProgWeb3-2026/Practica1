@page
@model Libreria.Pages.Usuarios.DeleteModel
@{
    ViewData["Title"] = "Eliminar Usuario";
}

<h1>Eliminar Usuario</h1>
<h3 class="text-danger">¿Está seguro de que desea eliminar este usuario?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Usuario.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Usuario.Nombre)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Usuario.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Usuario.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Usuario.Telefono)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Usuario.Telefono)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Usuario.Direccion)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Usuario.Direccion)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Usuario.FechaRegistro)</dt>
        <dd class="col-sm-9">@Model.Usuario.FechaRegistro.ToString("dd/MM/yyyy")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Usuario.Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>