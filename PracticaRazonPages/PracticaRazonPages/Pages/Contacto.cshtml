@page
@model PracticaRazonPages.Pages.ContactoModel
@{
}
<div class="card shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Formulario.Nombre" class="form-label fw-semibold"></label>
                <input asp-for="Formulario.Nombre" class="form-control" placeholder="Tu nombre completo" />
                <span asp-validation-for="Formulario.Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Formulario.Email" class="form-label fw-semibold"></label>
                <input asp-for="Formulario.Email" class="form-control" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Formulario.Email" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Formulario.Mensaje" class="form-label fw-semibold"></label>
                <textarea asp-for="Formulario.Mensaje" class="form-control" rows="4"
                          placeholder="Escribe tu mensaje aquí..."></textarea>
                <span asp-validation-for="Formulario.Mensaje" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar mensaje</button>
        </form>
    </div>
</div>
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        ✅ @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
