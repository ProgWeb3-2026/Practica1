@page
@model PracticaRazorPages.Pages.ContactoModel
@{
    ViewData["Title"] = "Contacto";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">Formulario de Contacto</h2>

            
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" class="card p-4 shadow-sm">
                <div class="mb-3">
                    <label asp-for="Contacto.Nombre" class="form-label">Nombre Completo</label>
                    <input asp-for="Contacto.Nombre" class="form-control" placeholder="Ej: Juancito Banegas" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Contacto.Email" class="form-label">Correo Electrónico</label>
                    <input asp-for="Contacto.Email" type="email" class="form-control" placeholder="nombre@correo.com" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Contacto.Mensaje" class="form-label">Mensaje</label>
                    <textarea asp-for="Contacto.Mensaje" class="form-control" rows="4" placeholder="Escribe tu mensaje aquí..." required></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100">Enviar Formulario</button>
            </form>
        </div>
    </div>
</div>
