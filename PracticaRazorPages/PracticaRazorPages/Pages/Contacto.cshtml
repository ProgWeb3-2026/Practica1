@page
@model PracticaRazorPages.Pages.ContactoModel
@{
}
<div class="text-bg-info">@TempData["Mensaje"]</div>

<h2>Contacto</h2>
<form method="post">
    <div class="form-group">
        <label asp-for="Nombre">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
 
        <label asp-for="Mensaje">Mensaje</label>
        <textarea asp-for="Mensaje" class="form-control" rows="5"></textarea>
    </div>
 
    <button type="submit" class="btn btn-primary">Enviar</button>
</form>