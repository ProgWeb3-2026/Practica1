@page
@model PracticaRazorPages.Pages.Plantas.CreatePlantaModel
@{
    ViewData["Title"] = "CREAR";
}

<form method="post">
    <input asp-for="Planta.PlantaId" type="hidden" />
    <div class="mb-3">
        <label asp-for="Planta.NombreComun" class="form-label">Nombre Comun</label>
        <input asp-for="Planta.NombreComun" class="form-control" placeholder="Nombre Comun">

        <span asp-validation-for="Planta.NombreComun" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.NombreCientifico" class="form-label">Nombre Cientifico</label>
        <input asp-for="Planta.NombreCientifico" class="form-control" placeholder="Nombre Cientifico">
        <span asp-validation-for="Planta.NombreCientifico" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.Categoria" class="form-label">Categoria</label>
        <input asp-for="Planta.Categoria" class="form-control" placeholder="Categoria">
        <span asp-validation-for="Planta.Categoria" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.CorreoEncargado" class="form-label">Correo Encargado</label>
        <input asp-for="Planta.CorreoEncargado" class="form-control" placeholder="Correo Encargado">
        <span asp-validation-for="Planta.CorreoEncargado" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.Foto" class="form-label">Foto</label>
        <input asp-for="Planta.Foto" class="form-control" placeholder="Foto">
        <span asp-validation-for="Planta.Foto" class="text-danger"></span>
    </div>
    <button type="submit" value="Guardar" name="btnGuardar">CREAR</button>
    <br />
    <a asp-area="" asp-page="/Plantas/Index" class="link-info">VOLVER</a>
</form>