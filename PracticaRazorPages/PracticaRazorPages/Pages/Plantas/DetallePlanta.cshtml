@page
@model PracticaRazorPages.Pages.Plantas.DetallePlantaModel
@{
}
<h2>Bienvenido Usuario a tu modulo de plantas</h2>

@if (!string.IsNullOrWhiteSpace(Model.Planta.Foto))
{
    <img src="@Model.Planta.Foto" class="card-img-top" alt="@Model.Planta.NombreComun">
}
else
{
    <img src="~/imagenes/planta.jpg" class="card-img-top" alt="^@Model.Planta.NombreComun">
}
<div class="card-body">
    <h3 class="card-text">@Model.Planta.NombreComun</h3>
    <h5 class="card-title">@Model.Planta.NombreCientifico</h5>
    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
    <a href="#" class="btn btn-primary">Go somewhere</a>
</div>