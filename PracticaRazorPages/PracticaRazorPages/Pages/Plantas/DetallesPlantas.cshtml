@page
@model PracticaRazorPages.Pages.Plantas.DetallesPlantasModel
@{
}


    @if (!string.IsNullOrWhiteSpace(@Model.Planta.Foto))
    {
        <img src="@Model.Planta.Foto" class="card-img-top" alt="@Model.Planta.NombreComun">
    }
    else
    {
        <img src="~/img/planta.jpg" class="card - img - top" alt="@Model.Planta.NombreComun" />
    }
    <div class="card-body">
        <h3 class="card-title">@Model.Planta.NombreComun</h3>
        <h5>@Model.Planta.NombreCientifico</h5>
    </div>