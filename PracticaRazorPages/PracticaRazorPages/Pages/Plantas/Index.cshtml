@page
@model PracticaRazorPages.Pages.Plantas.IndexModel
@{
}

<h2>He aqui todas las plantas que te puedas imaginar</h2>

@foreach (var planta in Model.Plantas)
{
    <div class="card" style="width: 18rem;">
        @if (!string.IsNullOrWhiteSpace(planta.Foto))
        {
            <img src="@planta.Foto" class="card-img-top" alt="@planta.NombreComun">
        }
        else
        {
            <img src="~/imagenes/guisantralladora-plants-zoombies.png" class="card-img-top" alt="@planta.NombreComun">
        }
        <div class="card-body">
            <p class="card-text">@planta.NombreComun</p>
            <h5>@planta.NombreCientifico</h5>
        </div>

        <button href="" type="button" class="btn btn-warning">Ver detalles</button>
        <button type="button" class="btn btn-success">Editar</button>


    </div>
    <br>
}