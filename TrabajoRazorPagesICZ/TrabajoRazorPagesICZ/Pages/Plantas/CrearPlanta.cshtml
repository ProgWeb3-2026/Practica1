@page
@model TrabajoRazorPagesICZ.Pages.Plantas.CrearPlantaModel
@{
}

<h1>CREAR UNA PLANTA</h1>

<form method="post">
    <input asp-for="Planta.PlantaId" type="hidden" />
    <div asp-validation-summary="All"></div>

    <div class="mb-3">
        <label asp-for="Planta.NombreComun" class="form-label">Nombre Comun</label>
        <input asp-for="Planta.NombreComun" class="form-control" placeholder="NombreComun">

        <span asp-validation-for="Planta.NombreComun" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.NombreCientifico" class="form-label">Nombre Cientifico</label>
        <input asp-for="Planta.NombreCientifico" class="form-control" placeholder="NombreCientifico">

        <span asp-validation-for="Planta.NombreComun" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.Categoria" class="form-label">Categoria</label>
        <input asp-for="Planta.Categoria" class="form-control" placeholder="Categoria">

        <span asp-validation-for="Planta.NombreComun" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.CorreoEncargado" class="form-label">Correo Encargado</label>
        <input asp-for="Planta.CorreoEncargado" class="form-control" placeholder="Correo Encargado">

        <span asp-validation-for="Planta.NombreComun" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Planta.Foto" class="form-label">Foto</label>
        <input asp-for="Planta.Foto" class="form-control" placeholder="Foto">

        <span asp-validation-for="Planta.NombreComun" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary" value="Guardar">Crear Planta</button>
</form>

<a asp-area="" asp-page="Index" class="link-info">Volver al index</a>