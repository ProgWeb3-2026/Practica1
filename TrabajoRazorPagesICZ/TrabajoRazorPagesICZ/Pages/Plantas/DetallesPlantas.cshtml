@page
@model TrabajoRazorPagesICZ.Pages.Plantas.ModeloDetalladoPlantasModel
@{
}

<h2>Detalles de la planta son los siguientes:</h2>

@if (!string.IsNullOrWhiteSpace(@Model.Planta.Foto))
{
    <img src="@Model.Planta.Foto" class="card-img-top" alt="@Model.Planta.NombreComun" />
}
else
{
    <img src="~/images/planta.jfif" class="card - img - top" alt="@Model.Planta.NombreComun" />
}


<div class="card-body">
    <h3 class="card-text">@Model.Planta.NombreComun</h3>
    <p>@Model.Planta.NombreCientifico</p>
</div>
<a asp-area="" asp-page="Index" class="link-info">Volver al index</a>